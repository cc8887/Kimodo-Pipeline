{
  "extends": "production_rules.json",
  "motionScope": ["Sprint", "Sprint_Acceleration", "Walk_Backward"],
  "promptModules": {
    "schemaVersion": 1,
    "subject": "A person",
    "style": "feminine",
    "modules": {
      "walk": {
        "slot": "action",
        "text": "is walking",
        "claims": {
          "action": "walk"
        }
      },
      "run": {
        "slot": "action",
        "text": "is running",
        "claims": {
          "action": "run"
        }
      },
      "sprint": {
        "slot": "action",
        "text": "is sprinting",
        "claims": {
          "action": "sprint"
        }
      },
      "forward": {
        "slot": "direction",
        "text": "forward",
        "claims": {
          "direction": "forward",
          "heading": "forward"
        }
      },
      "backward": {
        "slot": "direction",
        "text": "backward",
        "claims": {
          "direction": "backward",
          "heading": "forward"
        }
      },
      "left": {
        "slot": "direction",
        "text": "to their left while facing forward",
        "claims": {
          "direction": "left",
          "heading": "forward"
        }
      },
      "steady": {
        "slot": "phase",
        "text": "at a steady pace with complete alternating strides",
        "claims": {
          "phase": "steady",
          "contact": "alternating"
        }
      },
      "sprint-drive": {
        "slot": "phase",
        "text": "at a sustained fast pace with complete alternating strides",
        "claims": {
          "phase": "steady",
          "contact": "alternating"
        }
      },
      "standing": {
        "slot": "stance",
        "text": "at standing height",
        "claims": {
          "stance": "standing"
        }
      },
      "crouching": {
        "slot": "stance",
        "text": "in a low crouch",
        "claims": {
          "stance": "crouching"
        }
      },
      "upright-standing": {
        "slot": "posture",
        "text": "a straight relaxed back and balanced upright head",
        "claims": {
          "torsoPose": "upright",
          "headPose": "balanced"
        },
        "when": {
          "stance": "standing"
        }
      },
      "inclined-crouch": {
        "slot": "posture",
        "text": "the torso leaning naturally over the bent knees",
        "claims": {
          "torsoPose": "inclined"
        },
        "when": {
          "stance": "crouching"
        }
      },
      "steady-upper-arms": {
        "slot": "arms",
        "text": "upper arms held steady close to the torso",
        "claims": {
          "upperArmMotion": "steady",
          "armSpread": "narrow"
        }
      },
      "moving-forearms": {
        "slot": "arms",
        "text": "forearms swinging so the hands clearly move forward and back",
        "claims": {
          "forearmMotion": "swinging",
          "handMotion": "visible"
        }
      },
      "feminine-quality": {
        "slot": "style",
        "text": "smooth graceful movement",
        "claims": {
          "movementStyle": "graceful"
        }
      },
      "athletic-standing": {
        "slot": "posture",
        "text": "the torso inclined slightly into the movement",
        "claims": {
          "torsoPose": "inclined"
        },
        "when": {
          "stance": "standing"
        }
      },
      "athletic-arms": {
        "slot": "arms",
        "text": "coordinated upper-arm and forearm swings",
        "claims": {
          "upperArmMotion": "swinging",
          "forearmMotion": "swinging",
          "handMotion": "visible"
        }
      },
      "athletic-quality": {
        "slot": "style",
        "text": "brisk purposeful movement",
        "claims": {
          "movementStyle": "athletic"
        }
      }
    },
    "styles": {
      "neutral": [],
      "feminine": [
        "upright-standing",
        "inclined-crouch",
        "steady-upper-arms",
        "moving-forearms",
        "feminine-quality"
      ],
      "athletic": [
        "athletic-standing",
        "inclined-crouch",
        "athletic-arms",
        "athletic-quality"
      ]
    },
    "motions": {
      "Walk_Backward": {
        "modules": [
          "walk",
          "backward",
          "steady",
          "standing"
        ]
      },
      "Sprint": {
        "modules": [
          "sprint",
          "forward",
          "steady",
          "standing"
        ]
      },
      "Sprint_Acceleration": {
        "base": "Sprint",
        "remove": [
          "steady"
        ],
        "add": [
          "sprint-drive"
        ]
      }
    }
  },
  "locomotionOverrides": {
    "Sprint": {
      "velocity": 6,
      "direction": [
        0,
        1
      ],
      "headingDegrees": 0
    },
    "Sprint_Acceleration": {
      "velocity": 5,
      "direction": [
        0,
        1
      ],
      "headingDegrees": 0
    },
    "Walk_Backward": {
      "velocity": 1.5,
      "direction": [
        0,
        -1
      ],
      "headingDegrees": 0
    }
  },
  "gaitClosure": {
    "Walk_Backward": {
      "candidateSeconds": 3,
      "discoverySeconds": 3,
      "constraintReference": "native_als",
      "nativePhaseEvidence": true,
      "preserveReferencePelvisPath": true,
      "preserveReferenceHeading": true,
      "poseConstraintMode": "feet_only",
      "supportAnchorCount": 2,
      "maximumConstraintCycles": 2,
      "fullBodyPhaseCycles": 2,
      "fullBodyPhaseFractions": [
        0.5
      ],
      "boundaryContextFrames": 0,
      "cfgWeights": [
        2,
        4
      ],
      "repairAfterGeneration": true,
      "repairSelection": "bounded",
      "maximumRepairAttempts": 24,
      "maximumRepairCandidateCycles": 4,
      "maximumAnchorCorrectionMeters": 0.15
    },
    "Sprint": {
      "candidateSeconds": 3,
      "discoverySeconds": 3,
      "constraintReference": "native_als",
      "nativePhaseEvidence": true,
      "preserveReferencePelvisPath": true,
      "preserveReferenceHeading": true,
      "poseConstraintMode": "feet_only",
      "supportAnchorCount": 2,
      "maximumConstraintCycles": 2,
      "fullBodyPhaseCycles": 2,
      "fullBodyPhaseFractions": [
        0.5
      ],
      "boundaryContextFrames": 0,
      "cfgWeights": [
        2,
        4
      ],
      "repairAfterGeneration": true,
      "repairSelection": "bounded",
      "maximumRepairAttempts": 24,
      "maximumRepairCandidateCycles": 4,
      "maximumAnchorCorrectionMeters": 0.15
    },
    "Sprint_Acceleration": {
      "candidateSeconds": 3,
      "discoverySeconds": 3,
      "constraintReference": "native_als",
      "nativePhaseEvidence": true,
      "preserveReferencePelvisPath": true,
      "preserveReferenceHeading": true,
      "poseConstraintMode": "feet_only",
      "supportAnchorCount": 2,
      "maximumConstraintCycles": 2,
      "fullBodyPhaseCycles": 2,
      "fullBodyPhaseFractions": [
        0.5
      ],
      "boundaryContextFrames": 0,
      "cfgWeights": [
        2,
        4
      ],
      "repairAfterGeneration": true,
      "repairSelection": "bounded",
      "maximumRepairAttempts": 24,
      "maximumRepairCandidateCycles": 4,
      "maximumAnchorCorrectionMeters": 0.15
    }
  }
}
